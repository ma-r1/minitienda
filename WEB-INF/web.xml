<?xml version="1.0" encoding="ISO-8859-1"?>

<!DOCTYPE web-app
PUBLIC "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
"http://java.sun.com/j2ee/dtds/web-app_2_3.dtd">

<web-app>

  <context-param>
    <param-name>db.url</param-name>
    <param-value>jdbc:postgresql://localhost:5432/minitienda</param-value>
  </context-param>

  <context-param>
    <param-name>db.usuario</param-name>
    <param-value>postgres</param-value>
  </context-param>
  
  <context-param>
    <param-name>db.clave</param-name>
    <param-value>password</param-value>
  </context-param>

  <servlet>
    <servlet-name>ServletFrontController</servlet-name>
    <servlet-class>minitienda.controlador.ServletFrontController</servlet-class>
  </servlet>

  <servlet-mapping>
    <servlet-name>ServletFrontController</servlet-name>
    <url-pattern>/ServletFrontController</url-pattern>
  </servlet-mapping>
<!--  -->
</web-app>